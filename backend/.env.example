# Copy to backend/.env and fill in. Never commit .env (it is gitignored).

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Required. Placeholder values only; put the real connection string in .env.
# Local mongod:       mongodb://127.0.0.1:27017/grammar-for-ielts
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster-host>/grammar-for-ielts?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/grammar-for-ielts

# Comma-separated exact origins allowed to call the API from a browser (no paths, no wildcards).
# Defaults to the local Vite dev/preview origins when unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Session cookie name. In production over HTTPS, prefer __Host-gfi_session.
SESSION_COOKIE_NAME=gfi_session

# Frontend URL for links in emails. Required in production.
APP_BASE_URL=http://localhost:5173

# log (default): emails are written to the log (with their links only outside production).
# resend: send through the Resend API; then MAIL_FROM and RESEND_API_KEY are required.
MAIL_TRANSPORT=log
# MAIL_FROM=Grammar for IELTS <no-reply@your-domain>
# RESEND_API_KEY=<your Resend API key>

# Reverse proxies in front of the API (0 = none). Set to the host's real count, often 1.
TRUST_PROXY=0

# MongoDB driver pool and timeouts (ms). Defaults shown.
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=0
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_CONNECT_TIMEOUT_MS=10000
# MONGODB_SOCKET_TIMEOUT_MS=45000
